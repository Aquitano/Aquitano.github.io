---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Manifesto from '../components/Manifesto.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Stack from '../components/Stack.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import KeyboardNav from '../components/KeyboardNav.astro';

const work = (await getCollection('work')).toSorted((a, b) => a.data.order - b.data.order);
---

<Layout>
    <main id="main-content" tabindex="-1">
        <Hero />
        <Projects work={work.slice(0, 2)} />
        <ProjectIndex work={work.slice(2)} />
        <Manifesto />
        <Experience />
        <Stack />
    </main>
    <KeyboardNav />
</Layout>
