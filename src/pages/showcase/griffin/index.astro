---
import DemoNotice from '../../../components/GriffinDemoNotice.astro';
import "font-awesome/css/font-awesome.min.css";
import "@fontsource/yantramanav/300.css";
import "@fontsource/yantramanav/400.css";
import "@fontsource/yantramanav/500.css";
import "@fontsource/yantramanav/700.css";
import "@fontsource/yantramanav/900.css";
import { getGriffinAsset, griffinPageScripts, griffinStylesheets } from './_demo/assets';

const heroImageUrl = getGriffinAsset('images/Callicarpa_acuminata_Woodlanders_2_1_1024x1024@2x.jpg');
const homeBackgroundUrl = getGriffinAsset('images/home2_bg2.png');
---

<!doctype html>
<html lang="de">
    <head>
        <meta charset="utf-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="robots" content="noindex, follow" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <meta name="description" content="Der originale Griffin Energy Drink mit Brummselbeere! Schulprojekt" />
        <link rel="shortcut icon" type="image/x-icon" href={getGriffinAsset('favicon.jpg')} />
        <meta
            name="keywords"
            content="Brummselbeere, Griffin, GreenGriffin, Griffin Energy, ASG, ASG Passau, GriffinEnergy, Onlineshop, Energy Drink"
        />
        <title>Griffin Energy</title>
        {griffinStylesheets.map((href) => <link rel="stylesheet" href={href} />)}
    </head>
    <body>
        <DemoNotice />
        <!-- ==== Start header --><!-- header-desktop -->
        <header class="header home2">
            <!-- header-main -->
            <div class="header-main pb-30">
                <div class="container">
                    <nav id="nav" class="navbar">
                        <div class="nav-collapse"><span></span></div>
                        <div class="navbar-header">
                            <!-- Logo -->
                            <div class="navbar-brand">
                                <a class="logo" href="/showcase/griffin/">
                                    <img
                                        src={getGriffinAsset('images/2logo.png')}
                                        alt="Griffin Energy Drink Markenlogo"
                                        style="width: 73%;"
                                        loading="lazy"
                                        width="225"
                                        height="115"
                                    />
                                </a>
                            </div>
                            <!-- /Logo -->
                        </div>
                        <!-- Main navigation -->
                        <div class="otf-flex-item"></div>
                        <ul class="main-nav nav navbar-nav navbar-right">
                            <li class="dropdown active"><a aria-current="page" href="/showcase/griffin/" rel="prefetch">Home</a></li>
                            <li class="dropdown"><a href="/showcase/griffin/Product/" rel="prefetch">Product</a></li>
                            <li class="dropdown">
                                <a href="/showcase/griffin/Donation-Code/" rel="prefetch">Donation-Code</a>
                            </li>
                        </ul>
                        <!-- /Main navigation -->
                        <div class="otf-flex-item"></div>
                        <div class="site-header -icon">
                            <!-- cart -->
                            <div class="site-header__cart item-dropdown">
                                <a href="#" class="site-header__cart-toggle"
                                    ><span class="cartcount">0</span>
                                    <i class="fa fa-shopping-basket" aria-hidden="true"></i>
                                    <span class="cartcost"
                                        ><span class="money" data-currency-usd="0.00€">0.00€</span></span
                                    ></a
                                >
                                <div class="widget_shopping_cart_content content-dropdown">
                                    <p class="buttons clearfix">
                                        <a
                                            href="#"
                                            class="btn view-cart btn-default btn-normal"
                                            style="right: 0; left: 48px">Zum Einkaufswagen</a
                                        >
                                    </p>
                                </div>
                            </div>
                        </div>
                    </nav>
                </div>
            </div>
            <!-- /header-main -->
        </header>
        <!-- /header-desktop -->
        <!-- header-mobile -->
        <div class="header-mobile home2">
            <nav class="navbar">
                <div class="navbar-header">
                    <button
                        type="button"
                        class="navbar-toggle collapsed"
                        data-toggle="collapse"
                        data-target="#bs-example-navbar-collapse-1"
                        aria-controls="bs-example-navbar-collapse-1"
                        aria-expanded="false"
                    >
                        <span class="sr-only">Navigation öffnen</span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span></button
                    ><!-- logo -->
                    <div class="navbar-brand">
                        <a class="logo" href="/showcase/griffin/"
                            ><img src={getGriffinAsset('images/2logo.png')} alt="Griffin Energy Drink Markenlogo" loading="lazy" width="225" height="115" />
                            <!-- logo -->
                        </a>
                        <div class="navbar-collapse collapse" id="bs-example-navbar-collapse-1">
                            <ul class="nav navbar-nav">
                                <li class="active">
                                    <a aria-current="page" href="/showcase/griffin/" rel="prefetch"
                                        >Home</a
                                    >
                                </li>
                                <li class="">
                                    <a
                                        href="/showcase/griffin/Product/"
                                        rel="prefetch">Product</a
                                    >
                                </li>
                                <li class="">
                                    <a
                                        href="/showcase/griffin/Donation-Code/"
                                        rel="prefetch">Donation-Code</a
                                    >
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>
        </div>
        <!-- /header-mobile -->
        <!-- ===== End header -->
        <main id="demo-content" tabindex="-1">
            <section class="griffin-hero" style={`--hero-image: url(${heroImageUrl})`}>
                <div class="container griffin-hero-grid">
                    <div class="griffin-hero-copy">
                        <h1><span>The Original*</span> Brummselbeeren Drink</h1>
                        <a class="btn btn-primary" href="/showcase/griffin/Product/">
                            Produkt ansehen <i class="fa fa-long-arrow-right" aria-hidden="true"></i>
                        </a>
                    </div>
                    <img
                        src={getGriffinAsset('images/untitled2.png')}
                        alt="Zwei Dosen Griffin Energy Drink"
                        width="826"
                        height="1002"
                        fetchpriority="high"
                        class="griffin-hero-image"
                    />
                </div>
            </section>
            <!-- ==== End slider --><!-- ==== Start feature-icon-absolute -->
            <section class="features feature-icon-absolute clearfix text-center">
                <div class="container">
                    <div class="row">
                        <div class="col-md-3 col-sm-6 features_content">
                            <div class="features_list">
                                <div class="features-images">
                                    <img
                                        src={getGriffinAsset('images/icon-feature2.png')}
                                        alt="Symbol Blitz für Energie"
                                        loading="lazy"
                                        width="60"
                                        height="60"
                                    />
                                </div>
                                <div class="features-description">
                                    <h4>Energiespender</h4>
                                    <p>Durch die Brummselbeere maximaler Schub</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6 features_content">
                            <div class="features_list">
                                <div class="features-images">
                                    <img
                                        src={getGriffinAsset('images/icon-feature1.png')}
                                        alt="Icon Blatt für Bio-Zutaten"
                                        loading="lazy"
                                        width="58"
                                        height="60"
                                    />
                                </div>
                                <div class="features-description">
                                    <h4>Bio-Zutaten</h4>
                                    <p>Nur sorgfältig ausgewählte Bio-Zutaten</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6 features_content">
                            <div class="features_list">
                                <div class="features-images">
                                    <img
                                        src={getGriffinAsset('images/icon-feature3.png')}
                                        alt="Icon Dose Größe"
                                        loading="lazy"
                                        width="32"
                                        height="60"
                                    />
                                </div>
                                <div class="features-description">
                                    <h4>Verpackungsgröße</h4>
                                    <p>250ML</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6 features_content">
                            <div class="features_list">
                                <div class="features-images">
                                    <img
                                        src={getGriffinAsset('images/icon-feature9.png')}
                                        alt="Icon Recycling-Symbol"
                                        loading="lazy"
                                        width="60"
                                        height="66"
                                    />
                                </div>
                                <div class="features-description">
                                    <h4>Recycling</h4>
                                    <p>Aluminium-Dosen sind zu 100% recycelbar</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <!-- ==== End feature-icon-absolute -->
            <div class="container"><p style="padding-top: 118px"></p></div>
            <!-- ==== Start features-taste -->
            <section
                class="features skin1 features-taste section-bg clearfix pt-100 pb-100 text-white"
                style={`background-image: url(${homeBackgroundUrl})`}
            >
                <div class="container">
                    <div class="features-heading">
                        <h2 class="features-heading__title">Warum Griffin Energy?</h2>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="features_list pt-50 pb-50">
                                <div class="features-images">
                                    <img
                                        src={getGriffinAsset('images/icon-feature5.png')}
                                        alt="Coffein"
                                        loading="lazy"
                                        width="46"
                                        height="60"
                                    />
                                </div>
                                <div class="features-description">
                                    <h4>Koffein</h4>
                                    <p>
                                        Das enthaltene Koffein hilft dir zu einem wach zu bleiben, aber auch lindert es
                                        Kopfschmerzen oder Migräne.
                                    </p>
                                </div>
                            </div>
                            <div class="features_list pt-50 pb-50" style="margin-top: 60px">
                                <div class="features-images">
                                    <img src={getGriffinAsset('images/icon-feature10.png')} alt="Icon Baum Nachhaltigkeit" loading="lazy" width="60" height="61" />
                                </div>
                                <div class="features-description">
                                    <h4>Nachhaltigkeit</h4>
                                    <p>
                                        Durch verschiedene Methoden, wie umweltfreundliche Transportlogistik oder
                                        recycelbare Aluminium-Dosen, stoßen wir 40% weniger CO2 als andere Hersteller
                                        aus.
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-1"></div>
                        <div class="col-md-4">
                            <div class="features_list pt-50 pb-50">
                                <div class="features-images">
                                    <img src={getGriffinAsset('images/icon-feature2.png')} alt="Icon Vitamin Blitz" loading="lazy" width="60" height="60" />
                                </div>
                                <div class="features-description">
                                    <h4>Vitamine und Minerale</h4>
                                    <p>
                                        Durch lebensnotwendige Vitamine und Tiefsee-Minerale, die in einer Dose
                                        enthalten sind, wird nicht nur die Leistungsfähigkeit gesteigert, sondern auch
                                        u.a. Erschöpfung vorgebeugt.
                                    </p>
                                </div>
                            </div>
                            <div class="features_list pt-50 pb-50">
                                <div class="features-images">
                                    <img src={getGriffinAsset('images/icon-feature11.png')} alt="Icon Spenden Hand Herz" loading="lazy" width="60" height="82" />
                                </div>
                                <div class="features-description">
                                    <h4>Spenden</h4>
                                    <p>
                                        Du kannst pro Dose ein wohltätiges Projekt mit 5 Cent unterstützen, indem du den
                                        auf der Dose abgedrückten QR-Code einscannst.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <!-- ==== End features-taste --><!-- ==== Start product -->
            <section class="products pt-60 pb-100">
                <div class="container">
                    <div class="features-heading skin2">
                        <h2 class="features-heading__title">Produkte</h2>
                    </div>
                    <div class="row">
                        <div class="col-md-6 pt-40">
                            <div class="text-center">
                                <div class="product_deal">
                                    <div class="product-block">
                                        <div class="product-image">
                                            <div class="product-thumbnail">
                                                <a href="/showcase/griffin/Product/"
                                                    ><img
                                                        src={getGriffinAsset('images/untitled5-min.png')}
                                                        alt="Griffin Energy"
                                                        loading="lazy"
                                                        class="product-featured-image"
                                                        width="275"
                                                        height="372"
                                                    /></a
                                                >
                                            </div>
                                        </div>
                                        <div class="product-meta">
                                            <h4 class="product-name">
                                                <a href="/showcase/griffin/Product/">Griffin Energy</a>
                                            </h4>
                                            <div class="product-price">
                                                <span class="amout"
                                                    ><span class="money" data-currency-usd="$13.80">1.19€</span></span
                                                >
                                            </div>
                                            <div class="product-footer">
                                                <a href="/showcase/griffin/Product/" class="btn btn-primary"
                                                    >Produkt ansehen <i class="fa fa-long-arrow-right" aria-hidden="true"></i></a
                                                >
                                            </div>
                                        </div>
                                        <!-- /.product-meta -->
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 pt-40">
                            <div class="text-center">
                                <div class="product_deal">
                                    <div class="product-block">
                                        <div class="product-image">
                                            <div class="product-thumbnail">
                                                <a href="/showcase/griffin/Product2/" title=""
                                                    ><img
                                                        src={getGriffinAsset('images/untitled5b-min.png')}
                                                        alt="Griffin No Caffeine ansehen"
                                                        loading="lazy"
                                                        class="product-featured-image"
                                                        width="275"
                                                        height="372"
                                                    /></a
                                                >
                                            </div>
                                        </div>
                                        <div class="product-meta">
                                            <h4 class="product-name">
                                                <a href="/showcase/griffin/Product2/" title="">Griffin No Caffeine</a>
                                            </h4>
                                            <div class="product-price">
                                                <span class="amout"
                                                    ><span class="money" data-currency-usd="$13.80">1.19€</span></span
                                                >
                                            </div>
                                            <div class="product-footer">
                                                <a href="/showcase/griffin/Product2/" class="btn btn-primary"
                                                    >Produkt ansehen <i class="fa fa-long-arrow-right" aria-hidden="true"></i></a
                                                >
                                            </div>
                                        </div>
                                        <!-- /.product-meta -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <!-- ==== End product --><!-- ==== Start newsletter -->
            <section class="contact-form pt-100 pb-100">
                <div class="container">
                    <div class="row">
                        <div class="contact-form-container">
                            <div class="col-md-6 col-sm-12">
                                <div class="contact-form_heading text-uppercase">
                                    <span>NEWSLETTER</span>
                                    <h4>NUR ALS DEMO</h4>
                                </div>
                            </div>
                            <div class="col-md-6 col-sm-12">
                                <div class="newsletter">
                                    <p class="newsletter-description">
                                        Der Newsletter ist Teil des Schulprojekts. Eine Anmeldung ist in dieser Demo nicht möglich.
                                    </p>
                                    <form
                                        action="#"
                                        method="post"
                                        id="mc-embedded-subscribe-form"
                                        name="mc-embedded-subscribe-form"
                                        target="_blank"
                                        class="form-horizontal"
                                    >
                                        <div class="newsletter-form">
                                            <div class="input-group">
                                                <input
                                                    class="form-control"
                                                    type="email"
                                                    name="EMAIL"
                                                    aria-label="E-Mail-Adresse (Demo)"
                                                    autocomplete="email"
                                                    disabled
                                                    placeholder="Deine Email-Adresse"
                                                    required
                                                />
                                                <span class="input-group-btn"
                                                    ><button type="button" class="search-submit btn" aria-label="Newsletter-Anmeldung in der Demo nicht verfügbar" disabled>
                                                        <span class="fa fa-paper-plane-o" aria-hidden="true"
                                                        ></span></button
                                                    ></span
                                                >
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </main>

        <!-- ==== End newsletter --><!-- ==== Start footer -->
        <footer class="site-footer site-footer-2 clearfix">
            <div class="site-footer__main">
                <div class="container">
                    <div class="row">
                        <div class="col-md-6 col-sm-12 col-xs-12 footer-block">
                            <img src={getGriffinAsset('images/logo.png')} alt="Griffin Energy Wortmarke" loading="lazy" width="196" height="122" />
                            <p class="address pt-30">
                                *Dies ist ein fiktives Produkt und dient nur für schulische Zwecke.<br />
                                <a href="/privacy" style="text-decoration: underline">Datenschutz / Privacy</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="site-footer__copyright">
                <div class="container">
                    <div class="copyright_container">
                        <div class="copyright col-xs-12 text-center">GreenGriffin © 2021. All rights reserved</div>
                    </div>
                </div>
            </div>
        </footer>
        <!-- ==== End footer --><!-- Back to top -->
        <button id="back-to-top" type="button" aria-label="Nach oben"></button>
        <!-- /Back to to --><!-- ====Start Preloader -->
        <div id="preloader">
            <div class="preloader"><span></span><span></span><span></span><span></span></div>
        </div>
        <!-- ====End Preloader -->
        {
            griffinPageScripts.map((scriptUrl) => <script src={scriptUrl} defer is:inline></script>)
        }

    </body>
</html>

<style>
    .griffin-hero {
        background: linear-gradient(90deg, rgb(0 0 0 / 78%), rgb(0 0 0 / 35%)), var(--hero-image) center / cover;
        color: #fff;
        padding: 48px 0 128px;
    }

    .griffin-hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
        align-items: center;
        gap: 32px;
        min-height: min(55svh, 500px);
    }

    .griffin-hero-grid::before,
    .griffin-hero-grid::after {
        display: none;
    }

    .griffin-hero-copy h1 {
        margin: 0 0 32px;
        color: inherit;
        font-size: clamp(32px, 4.5vw, 64px);
        font-weight: 700;
        line-height: 1.15;
        text-wrap: balance;
    }

    .griffin-hero-copy h1 span {
        display: block;
        margin-bottom: 12px;
        font-size: 0.7em;
        font-weight: 400;
    }

    .griffin-hero-image {
        width: 100%;
        height: auto;
        max-height: 500px;
        object-fit: contain;
    }

    @media (max-width: 767px) {
        .griffin-hero {
            padding: 40px 0;
        }

        .griffin-hero-grid {
            grid-template-columns: minmax(0, 1fr);
            min-height: auto;
            gap: 24px;
        }

        .griffin-hero-image {
            max-height: 220px;
        }
    }
</style>
