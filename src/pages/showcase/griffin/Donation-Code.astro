---
import DemoNotice from '../../../components/GriffinDemoNotice.astro';
import "font-awesome/css/font-awesome.min.css";
import "@fontsource/yantramanav/300.css";
import "@fontsource/yantramanav/400.css";
import "@fontsource/yantramanav/500.css";
import "@fontsource/yantramanav/700.css";
import "@fontsource/yantramanav/900.css";
import { getGriffinAsset, griffinPageScripts, griffinStylesheets } from './_demo/assets';
---

<!doctype html>
<html lang="de">
    <head>
        <meta charset="utf-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="robots" content="noindex, follow" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="Der originale Griffin Energy Drink mit Brummselbeere! Schulprojekt" />
        <link rel="shortcut icon" type="image/x-icon" href={getGriffinAsset('favicon.jpg')} />

        <meta
            name="keywords"
            content="Brummselbeere, Griffin, GreenGriffin, Griffin Energy, ASG, ASG Passau, GriffinEnergy, Onlineshop, Energy Drink"
        />
        <title>Donation-Code | Griffin Energy Demo</title>
        {griffinStylesheets.map((href) => <link rel="stylesheet" href={href} />)}
    </head>

    <body>
        <DemoNotice />
        <!-- ===================================== ==== Start header -->
        <!-- Header desktop -->
        <header class="header home2">
            <!-- header-main -->
            <div class="header-main pb-30">
                <div class="container">
                    <nav id="nav" class="navbar">
                        <div class="nav-collapse"><span></span></div>
                        <div class="navbar-header">
                            <!-- Logo -->
                            <div class="navbar-brand">
                                <a class="logo" href="/showcase/griffin/">
                                    <img
                                        src={getGriffinAsset('images/2logo.png')}
                                        alt="Griffin Energy Drink"
                                        style="width: 73%"
                                        loading="lazy"
                                        width="225"
                                        height="115"
                                    />
                                </a>
                            </div>
                            <!-- /Logo -->
                        </div>
                        <!-- Main navigation -->
                        <div class="otf-flex-item"></div>
                        <ul class="main-nav nav navbar-nav navbar-right">
                            <li class="dropdown"><a href="/showcase/griffin/" rel="prefetch">Home</a></li>
                            <li class="dropdown"><a href="/showcase/griffin/Product/" rel="prefetch">Product</a></li>
                            <li class="dropdown active">
                                <a aria-current="page" href="/showcase/griffin/Donation-Code/" rel="prefetch">Donation-Code</a>
                            </li>
                        </ul>
                        <!-- /Main navigation -->
                        <div class="otf-flex-item"></div>
                        <div class="site-header -icon">
                            <!-- cart -->
                            <div class="site-header__cart item-dropdown">
                                <a href="#" class="site-header__cart-toggle"
                                    ><span class="cartcount">0</span>
                                    <i class="fa fa-shopping-basket" aria-hidden="true"></i>
                                    <span class="cartcost"
                                        ><span class="money" data-currency-usd="0.00€">0.00€</span></span
                                    ></a
                                >
                                <div class="widget_shopping_cart_content content-dropdown">
                                    <p class="buttons clearfix">
                                        <a
                                            href="#"
                                            class="btn view-cart btn-default btn-normal"
                                            style="right: 0; left: 48px">Zum Einkaufswagen</a
                                        >
                                    </p>
                                </div>
                            </div>
                        </div>
                    </nav>
                </div>
            </div>
            <!-- /header-main -->
        </header>
        <!-- /header-main -->
        <!-- /Headerdesktop -->
        <div class="header-mobile home2">
            <nav class="navbar">
                <div class="navbar-header">
                    <button
                        type="button"
                        class="navbar-toggle collapsed"
                        data-toggle="collapse"
                        data-target="#bs-example-navbar-collapse-1"
                        aria-controls="bs-example-navbar-collapse-1"
                        aria-expanded="false"
                    >
                        <span class="sr-only">Navigation öffnen</span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span></button
                    ><!-- logo -->
                    <div class="navbar-brand">
                        <a class="logo" href="/showcase/griffin/"
                            ><img src={getGriffinAsset('images/2logo.png')} alt="Griffin Energy Markenlogo" loading="lazy" width="225" height="115" /></a
                        >
                    </div>
                    <!-- logo -->
                </div>
                <div class="navbar-collapse collapse" id="bs-example-navbar-collapse-1">
                    <ul class="nav navbar-nav">
                        <li>
                            <a href="/showcase/griffin/" rel="prefetch"
                                >Home</a
                            >
                        </li>
                        <li>
                            <a
                                href="/showcase/griffin/Product/"
                                rel="prefetch">Product</a
                            >
                        </li>
                        <li class="active">
                            <a aria-current="page" href="/showcase/griffin/Donation-Code/" rel="prefetch"
                                >Donation-Code</a
                            >
                        </li>
                    </ul>
                </div>
            </nav>
        </div>
        <!-- /header-mobile -->
        <!-- End header ==== ======================================= -->
        <!-- ===================================== ==== Start breadcrumb -->
        <main id="demo-content" tabindex="-1">
        <div class="breadcrumb">
            <!-- container -->
            <div class="container">
                <h1>Donation-Code (Demo)</h1>
                <div class="item-breadcrumb">
                    <div class="coupon pull-left">
                        <input
                            type="text"
                            name="DC"
                            class="input-text TTT"
                            id="DC"
                            value=""
                            placeholder="Donation-Code (Demo)"
                            aria-label="Donation-Code (Demo)"
                            disabled
                        />

                    </div>
                </div>
            </div>
            <!-- /container -->
        </div>
        <!-- ===================================== ==== End breadcrumb -->
        <!-- ===================================== ====Start archive-product -->
        <div class="archive-product">
            <!-- Container -->
            <div class="container">
                <!-- tab-content -->
                <div class="tab-content">
                    <h2>Spendenkonzept</h2>
                    <div id="grid-view" class="tab-pane fade in active">
                        <div class="product products-grid">
                            <div class="row row-products">
                                <div class="col-md-4 col-sm-6">
                                    <div class="product-block" data-publish-date="">
                                        <div class="product-image product_1">
                                            <div class="product-thumbnail">
                                                <a href="https://www.arborday.org/" title=""
                                                    ><img
                                                        src={getGriffinAsset('images/ArborDayFoundatiion.png')}
                                                        alt="Arbor Day Foundation"
                                                        style="width: 132px"
                                                        class="product-featured-image"
                                                        width="487"
                                                        height="487"
                                                    /></a
                                                >
                                            </div>
                                        </div>
                                        <!-- /.product-image -->
                                        <div class="product-meta">
                                            <!-- end rating -->
                                            <h3 class="product-name">
                                                <a href="https://www.arborday.org/" title="">Arbor Day Foundation</a
                                                ><button type="button" class="demo-donation" disabled>Spenden (nur Demo)</button>
                                            </h3>
                                        </div>
                                        <!-- /.product-meta -->
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6">
                                    <div class="product-block" data-publish-date="">
                                        <div class="product-image product_2">
                                            <div class="product-thumbnail">
                                                <a href="https://www.ifaw.org/de" title=""
                                                    ><img
                                                        src={getGriffinAsset('images/ifaw.jpg')}
                                                        alt="International Fund for Animal Welfare"
                                                        style="width: 250px"
                                                        class="product-featured-image"
                                                        width="1200"
                                                        height="630"
                                                    /></a
                                                >
                                            </div>
                                        </div>
                                        <!-- /.product-image -->
                                        <div class="product-meta">
                                            <span></span>
                                            <!-- end rating -->
                                            <h3 class="product-name">
                                                <a href="https://www.ifaw.org/de" title="">International Fund for Animal Welfare</a
                                                ><button type="button" class="demo-donation" disabled>Spenden (nur Demo)</button>
                                            </h3>
                                        </div>
                                        <!-- /.product-meta -->
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6">
                                    <div class="product-block" data-publish-date="">
                                        <div class="product-image">
                                            <div class="product-thumbnail">
                                                <a href="https://www.savethechildren.org/" title=""
                                                    ><img
                                                        src={getGriffinAsset('images/SaveTheChildren.jpg')}
                                                        alt="Save the Children"
                                                        style="width: 130px"
                                                        class="product-featured-image"
                                                        width="1900"
                                                        height="1900"
                                                    /></a
                                                >
                                            </div>
                                        </div>
                                        <!-- /.product-image -->
                                        <div class="product-meta">
                                            <!-- end rating -->
                                            <h3 class="product-name">
                                                <a href="https://www.savethechildren.org/" title=""
                                                    >Save the Children
                                                </a><button type="button" class="demo-donation" disabled>Spenden (nur Demo)</button></h3>
                                        </div>
                                        <!-- /.product-meta -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- /tab-content -->
            </div>
        </div>
        <!-- ===================================== ====End archive-product -->
        <!-- ===================================================================== ==== Start footer -->
        </main>
        <footer class="site-footer site-footer-2 clearfix">
            <div class="site-footer__main">
                <div class="container">
                    <div class="row">
                        <div class="col-md-6 col-sm-12 col-xs-12 footer-block">
                            <img src={getGriffinAsset('images/logo.png')} alt="Griffin Energy Markenlogo" width="196" height="122" />
                            <p class="address pt-30">
                                *Dies ist ein fiktives Produkt und dient nur für schulische Zwecke. <br />
                                <a href="/privacy" style="text-decoration: underline">Datenschutz / Privacy</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="site-footer__copyright">
                <div class="container">
                    <div class="copyright_container">
                        <div class="col-md-4 col-sm-6">

                        </div>
                        <div class="copyright col-md-4 col-sm-6">GreenGriffin © 2021. All rights reserved</div>
                    </div>
                </div>
            </div>
        </footer>
        <!-- ===================================================================== ==== End footer -->
        <!-- Back to top -->
        <button id="back-to-top" type="button" aria-label="Nach oben"></button>
        <!-- / Back to to -->
        <!-- ===================================================================== ====Start Preloader -->
        <div id="preloader">
            <div class="preloader"><span></span><span></span><span></span><span></span></div>
        </div>
        <!-- ===================================================================== ====End Preloader -->
        <!-- ====Start all js here -->
        {
            griffinPageScripts.map((scriptUrl) => <script src={scriptUrl} defer is:inline></script>)
        }
        <script defer is:inline>
            document.addEventListener('DOMContentLoaded', () => {
                $('#preloader').delay(600).fadeOut();
            });
        </script>
        <!-- ==== End all js here -->
    </body>
</html>
