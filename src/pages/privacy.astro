---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/data';

const entry = await getEntry('legal', 'privacy');

if (!entry) throw new Error('public/privacy.md is missing');

const { Content } = await render(entry);
---

<Layout title={`Privacy | ${site.name}`} description="How thomasbreindl.me handles server logs, email and your data.">
    <main id="top" class="section-x pt-28 pb-16 md:pt-40">
        <a href="/" class="link-line pressable touch-target meta inline-block text-fg">
            <span aria-hidden="true">←</span> Home
        </a>
        <article class="mt-10 max-w-2xl space-y-6 text-base leading-relaxed text-fg/85 md:mt-14">
            <Content />
        </article>
    </main>
</Layout>

<style>
    article :global(h1) {
        margin-bottom: 3rem;
        font-size: clamp(2.25rem, 9vw, 6rem);
        font-stretch: 125%;
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: var(--display-leading);
        text-transform: uppercase;
        color: var(--fg);
    }

    article :global(h2) {
        padding-top: 1.5rem;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--accent);
    }

    article :global(ul) {
        padding-left: 1.25rem;
        list-style: disc;
    }

    article :global(a) {
        color: var(--fg);
        text-decoration: underline;
        text-decoration-color: var(--muted);
        text-underline-offset: 0.2em;
    }

    article :global(a:hover) {
        text-decoration-color: var(--accent);
    }

    article :global(strong) {
        color: var(--fg);
    }

    article :global(code) {
        border: 1px solid var(--line);
        border-radius: 0.25rem;
        background: var(--bg-raise);
        padding: 0.125rem 0.375rem;
        font-size: 0.85em;
    }
</style>
