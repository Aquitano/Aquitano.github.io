---
import { experience } from '../lib/data';
import ExperienceRow from './ExperienceRow.astro';
import SectionHeading from './SectionHeading.astro';
---

<section id="experience" data-experience data-minimap="Experience" data-nav="about" class="section-x section-y">
    <SectionHeading index="04" title="Experience" />
    <div>
        {experience.map((job) => (
            <div data-row class="relative border-b border-line">
                <ExperienceRow job={job} />
            </div>
        ))}
    </div>
</section>

<script>
    import { gsap, offscreen, prefersReducedMotion } from '../lib/gsap';

    const root = document.querySelector<HTMLElement>('[data-experience]');

    if (root && !prefersReducedMotion()) {
        for (const row of offscreen(gsap.utils.toArray<HTMLElement>('[data-row]'))) {
            gsap.from(row, {
                opacity: 0,
                y: 32,
                duration: 0.9,
                scrollTrigger: { trigger: row, start: 'top 88%', once: true },
            });
        }
    }
</script>
