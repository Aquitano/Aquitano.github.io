---
interface Props {
    index: string;
    title: string;
}

const { index, title } = Astro.props;
---

<div class="mb-8 flex items-baseline justify-between gap-6 border-t border-line pt-6 md:mb-10">
    <h2 class="heading text-3xl md:text-4xl">{title}</h2>
    <span class="font-mono text-xs text-muted tabular-nums" aria-hidden="true">
        /{index}
    </span>
</div>
