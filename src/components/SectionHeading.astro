---
interface Props {
    index: string;
    title: string;
    ruled?: boolean;
}

const { index, title, ruled = true } = Astro.props;
---

<div class:list={['mb-10 flex items-baseline gap-4 md:mb-16 md:gap-6 lg:gap-8', ruled && 'border-t border-line pt-5']}>
    <span class="meta shrink-0 text-accent tabular-nums lg:w-14">/{index}</span>
    <h2 class="display text-[clamp(1.75rem,4.2vw,3rem)] leading-[1.05]">{title}</h2>
    <span class="hidden h-px flex-1 self-center bg-line sm:block" aria-hidden="true"></span>
</div>
