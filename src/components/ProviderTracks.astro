---
import type { reconciliationRules } from '../lib/reconciliation';

interface Props {
    rule: (typeof reconciliationRules)[number];
}

const { rule } = Astro.props;
---

<div class="policy-tracks">
    <div class="track-axis" aria-hidden="true">
        {rule.axis.map((label) => (
            <span>{label}</span>
        ))}
    </div>
    {rule.tracks.map((track) => (
        <div class="provider-track">
            <p>{track.provider}</p>
            <div class="track-segments">
                {track.segments.map((segment) => (
                    <span
                        class:list={['record-segment', segment.kept ? 'kept' : 'raw-only']}
                        style={`grid-column:${segment.start} / span ${segment.span}`}
                    >
                        <span class="sr-only">{segment.kept ? 'Kept in canonical read' : 'Raw record only'}</span>
                    </span>
                ))}
            </div>
        </div>
    ))}
    <div class="track-legend">
        <span>
            <i class="kept" aria-hidden="true"></i>Kept in read
        </span>
        <span>
            <i class="raw-only" aria-hidden="true"></i>Raw only
        </span>
    </div>
</div>
<style>
    .track-axis {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.25rem;
        color: #b9a0ad;
        font-size: 0.6875rem;
    }
    .track-axis span:last-child {
        text-align: right;
    }
    .provider-track + .provider-track {
        margin-top: 1.25rem;
    }
    .provider-track p {
        margin-bottom: 0.5rem;
        font-size: 0.75rem;
    }
    .track-segments {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 3px;
        min-height: 30px;
        padding-block: 6px;
        background: repeating-linear-gradient(
            to right,
            transparent 0,
            transparent calc(25% - 1px),
            #382631 calc(25% - 1px),
            #382631 25%
        );
    }
    .record-segment {
        border-radius: 3px;
        min-height: 18px;
    }
    .kept {
        background: #d4a7bc;
        border: 1px solid #d4a7bc;
    }
    .raw-only {
        background: #281c24;
        border: 1px dashed #977385;
    }
    .track-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 1.5rem;
        color: #b9a0ad;
        font-size: 0.6875rem;
    }
    .track-legend > span {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .track-legend i {
        display: block;
        width: 16px;
        height: 10px;
        border-radius: 2px;
    }
</style>
