    }

    :global(button:disabled),
    :global(input:disabled) {
        cursor: not-allowed;
        opacity: 0.65;
    }

    :global(.demo-donation) {
        border: 0;
        background: transparent;
        padding: 8px;
        font: inherit;
    }

