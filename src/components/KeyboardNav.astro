---
const SHORTCUTS = [
    { keys: ['j'], label: 'Next stop' },
    { keys: ['k'], label: 'Previous stop' },
    { keys: ['g', 'g'], label: 'Jump to top' },
    { keys: ['Shift', 'G'], label: 'Jump to contact' },
    { keys: ['?'], label: 'Toggle this panel' },
    { keys: ['Esc'], label: 'Close' },
];
---

<dialog
    data-kbd-dialog
    aria-label="Homepage keyboard shortcuts"
    class="kbd-dialog m-auto w-[min(22rem,calc(100vw-2rem))] rounded-2xl border border-line bg-bg-raise/95 p-0 text-fg backdrop-blur-md"
>
    <div class="p-6 md:p-7">
        <div class="mb-5 flex items-center justify-between border-b border-line pb-4">
            <p class="meta text-accent">Homepage shortcuts</p>
            <button
                data-kbd-close
                type="button"
                aria-label="Close (Esc)"
                class="meta -mr-2 grid min-h-11 min-w-11 place-items-center rounded-md px-2 text-muted transition-colors duration-200 hover:text-fg"
            >
                esc
            </button>
        </div>
        <ul class="flex flex-col gap-3.5">
            {SHORTCUTS.map((s) => (
                <li class="flex items-center justify-between gap-6">
                    <span class="text-sm text-fg/85">{s.label}</span>
                    <span class="flex items-center gap-1">
                        {s.keys.map((k) => (
                            <kbd class="kbd-cap">{k}</kbd>
                        ))}
                    </span>
                </li>
            ))}
        </ul>
        <div class="mt-5 flex items-center justify-between gap-6 border-t border-line pt-4">
            <span id="kbd-toggle-label" class="text-sm text-fg/85">
                Single-key shortcuts
            </span>
            <button
                data-kbd-toggle
                type="button"
                role="switch"
                aria-checked="true"
                aria-labelledby="kbd-toggle-label"
                class="kbd-cap kbd-switch"
            >
                <span aria-hidden="true" data-kbd-toggle-text>
                    On
                </span>
            </button>
        </div>
    </div>
</dialog>

<button
    data-kbd-hint
    hidden
    type="button"
    aria-label="Show homepage shortcuts"
    class="kbd-hint group relative ml-auto hidden min-h-11 shrink-0 cursor-pointer items-center gap-2 rounded-md px-1 py-1.5 text-muted hover:text-fg data-off:flex pointer-fine:md:flex"
>
    <kbd class="kbd-cap">?</kbd>
    <span class="text-sm transition-colors duration-200 group-hover:text-fg">Homepage shortcuts</span>
</button>

<style>
    .kbd-cap {
        display: inline-block;
        min-width: 1.6rem;
        border: 1px solid var(--line);
        border-radius: 9999px;
        background: var(--bg);
        padding: 3px 9px;
        color: var(--fg);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        line-height: 1.4;
        letter-spacing: 0.06em;
        text-align: center;
    }

    .kbd-switch {
        min-width: 44px;
        min-height: 44px;
        transition:
            color 200ms,
            border-color 200ms;
    }

    .kbd-switch[aria-checked='true'] {
        border-color: color-mix(in oklch, var(--accent) 60%, transparent);
        color: var(--accent);
    }

    .kbd-hint {
        transition: color 200ms;
    }
    .kbd-hint[hidden] {
        display: none;
    }

    .kbd-dialog,
    .kbd-dialog::backdrop {
        transition:
            opacity 240ms var(--ease-out-strong),
            transform 240ms var(--ease-out-strong),
            overlay 240ms allow-discrete,
            display 240ms allow-discrete;
    }

    .kbd-dialog {
        overscroll-behavior: contain;
        opacity: 0;
        transform: translateY(8px) scale(0.98);
    }

    .kbd-dialog::backdrop {
        opacity: 0;
        background: color-mix(in oklch, #0a0a0b 68%, transparent);
        backdrop-filter: blur(2px);
    }

    .kbd-dialog[open],
    .kbd-dialog[open]::backdrop {
        opacity: 1;
        transform: none;
    }

    @starting-style {
        .kbd-dialog[open] {
            opacity: 0;
            transform: translateY(8px) scale(0.98);
        }

        .kbd-dialog[open]::backdrop {
            opacity: 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .kbd-dialog,
        .kbd-dialog::backdrop {
            transition: none;
        }
    }
</style>

<script>
    import { track } from '../lib/analytics';
    import { pauseScroll, resumeScroll, scrollToTarget, targetScrollY } from '../lib/lenis';

    const dialog = document.querySelector<HTMLDialogElement>('[data-kbd-dialog]');

    const hint = document.querySelector<HTMLElement>('[data-kbd-hint]');

    const stops: HTMLElement[] = [];

    for (const section of document.querySelectorAll<HTMLElement>('[data-minimap]')) {
        stops.push(section);

        for (const card of section.querySelectorAll<HTMLElement>('[data-card-wrapper]')) stops.push(card);
    }

    const reduce = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const isTyping = (el: Element | null) =>
        el instanceof HTMLElement && (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName));

    if (dialog && stops.length) {
        const HEADER_OFFSET = 88;

        let targets: number[] = [];

        const offsetOf = (el: HTMLElement) => {
            const offset = parseFloat(getComputedStyle(el).scrollMarginTop);

            return Number.isNaN(offset) ? HEADER_OFFSET : offset;
        };

        const measure = () => {
            const maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);

            targets = stops.map((el) =>
                Math.max(
                    0,
                    Math.min(maxScroll, Math.round(el.getBoundingClientRect().top + window.scrollY - offsetOf(el))),
                ),
            );
        };

        const currentIndex = () => {
            const scroll = targetScrollY();
            const active = document.activeElement;
            const focusedCard = active?.closest('[data-card-wrapper]');
            const focused = stops.findIndex((stop) => stop === active || stop === focusedCard);

            if (focused >= 0 && Math.abs(targets[focused] - scroll) <= 8) return focused;
            const line = scroll + 8;
            let idx = 0;
            targets.forEach((t, i) => {
                if (t <= line) idx = i;
            });

            return idx;
        };

        const goTo = (i: number) => {
            const j = Math.max(0, Math.min(targets.length - 1, i));
            const stop = stops[j];
            scrollToTarget(targets[j], { immediate: reduce() });

            const focusTarget = stop.hasAttribute('data-card-wrapper')
                ? (stop.querySelector<HTMLElement>('a[href]') ?? stop)
                : stop;

            if (focusTarget === stop && !stop.hasAttribute('tabindex')) stop.setAttribute('tabindex', '-1');
            focusTarget.focus({ preventScroll: true });
        };

        measure();
        let measureRaf = 0;

        const remeasure = () => {
            cancelAnimationFrame(measureRaf);
            measureRaf = requestAnimationFrame(measure);
        };

        window.addEventListener('resize', remeasure);
        window.addEventListener('load', measure);
        document.fonts?.ready.then(measure);

        const open = () => {
            if (dialog.open) return;
            dialog.showModal();
            pauseScroll();
        };

        const close = () => dialog.open && dialog.close();

        const ENABLED_KEY = 'kbd-shortcuts';
        let enabled = true;

        try {
            enabled = localStorage.getItem(ENABLED_KEY) !== 'off';
        } catch {
            /* storage blocked */
        }

        const toggle = dialog.querySelector<HTMLButtonElement>('[data-kbd-toggle]');
        const toggleText = toggle?.querySelector<HTMLElement>('[data-kbd-toggle-text]');

        const renderToggle = () => {
            toggle?.setAttribute('aria-checked', String(enabled));

            if (toggleText) toggleText.textContent = enabled ? 'On' : 'Off';
            // With shortcuts off, the button is the only way back to this switch, so it renders on touch screens too.
            hint?.toggleAttribute('data-off', !enabled);
        };

        renderToggle();
        toggle?.addEventListener('click', () => {
            enabled = !enabled;
            renderToggle();
            track('keyboard_shortcuts_toggled', { enabled });

            try {
                localStorage.setItem(ENABLED_KEY, enabled ? 'on' : 'off');
            } catch {
                /* storage blocked */
            }
        });

        let lastG = 0;
        window.addEventListener('keydown', (e) => {
            if (!enabled || e.metaKey || e.ctrlKey || e.altKey || isTyping(document.activeElement)) return;

            if (e.key === '?') {
                e.preventDefault();

                if (dialog.open) close();
                else open();

                return;
            }

            if (dialog.open) return;

            switch (e.key) {
                case 'j':
                    e.preventDefault();
                    goTo(currentIndex() + 1);
                    break;
                case 'k':
                    e.preventDefault();
                    goTo(currentIndex() - 1);
                    break;
                case 'G':
                    if (!e.shiftKey) break;
                    e.preventDefault();
                    goTo(stops.length - 1);
                    break;
                case 'g':
                    if (e.timeStamp - lastG < 500) {
                        goTo(0);
                        lastG = 0;
                    } else {
                        lastG = e.timeStamp;
                    }

                    break;
            }
        });

        dialog.querySelector('[data-kbd-close]')?.addEventListener('click', close);
        dialog.addEventListener('close', resumeScroll);
        // The panel fills the dialog box, so only a backdrop click targets the dialog itself.
        dialog.addEventListener('click', (e) => {
            if (e.target === dialog) close();
        });

        // Lenis stops wheel and touch behind the dialog; keys and the no-Lenis path need their own guard.
        const SCROLL_KEYS = new Set(['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' ']);
        dialog.addEventListener('keydown', (e) => {
            const activatesButton = e.key === ' ' && e.target instanceof HTMLButtonElement;

            if (SCROLL_KEYS.has(e.key) && !activatesButton) e.preventDefault();
        });

        for (const type of ['wheel', 'touchmove']) {
            dialog.addEventListener(type, (e) => e.preventDefault(), { passive: false });
        }

        if (hint) {
            hint.addEventListener('click', open);
            document.querySelector('[data-shortcut-tools]')?.append(hint);
            hint.hidden = false;
        }
    }
</script>
