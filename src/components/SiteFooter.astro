---
import { site, socials } from '../lib/data';
import { buildSha, commitUrl, buildDate } from '../lib/buildStamp';
import { opticalIndent } from '../lib/displayTitle';

const isHome = Astro.url.pathname === '/';
---

<footer
    id="contact"
    data-footer
    data-minimap="Contact"
    class:list={[
        'section-x relative overflow-hidden pb-8',
        isHome ? 'section-y--major pointer-fine:pb-20' : 'section-y--lead border-t border-line',
    ]}
>
    <div class="mb-16 md:mb-24">
        <p data-footer-reveal class="meta mb-6">
            {isHome && <span class="text-accent">/05 </span>}Got an interesting problem?
        </p>
        <a href={`mailto:${site.email}`} class="group block w-fit">
            <span class="block overflow-y-clip pb-[0.06em]">
                <span
                    data-footer-headline
                    class="display block text-[clamp(2.8rem,11.5vw,11rem)] transition-colors duration-300 group-hover:text-accent"
                >
                    <span style={opticalIndent('Let’s')}>Let’s</span>{' '}
                    <span class="whitespace-nowrap">
                        Talk
                        <span
                            aria-hidden="true"
                            class="ml-[0.1em] inline-block align-baseline text-[0.55em] transition-transform duration-300 ease-out-strong group-hover:translate-x-[0.1em] group-hover:-translate-y-[0.1em]"
                        >
                            ↗
                        </span>
                    </span>
                </span>
            </span>
        </a>
        <div data-footer-reveal>
            <button
                data-copy-email
                data-email={site.email}
                type="button"
                aria-label={`Copy email address: ${site.email}`}
                class="pressable group/copy mt-3 flex min-h-11 cursor-pointer items-center gap-3 py-3 font-mono text-xs text-muted transition-[color,transform] duration-200 hover:text-fg"
            >
                <span data-copy-text>{site.email}</span>
                <span data-copy-status role="status" aria-live="polite" class="inline-flex items-center">
                    <span
                        data-copy-default
                        aria-hidden="true"
                        class="rounded-full border border-line px-2.5 py-0.5 text-[0.625rem] tracking-[0.14em] uppercase transition-colors duration-200 group-hover/copy:border-accent/60 group-hover/copy:text-accent"
                    >
                        Copy
                    </span>
                    <span
                        data-copy-done
                        class="pop-in hidden rounded-full border border-transparent bg-accent px-2.5 py-0.5 text-[0.625rem] font-medium tracking-[0.14em] text-black uppercase"
                    >
                        Copied <span aria-hidden="true">✓</span>
                    </span>
                    <span
                        data-copy-fail
                        class="hidden rounded-full border border-line px-2.5 py-0.5 text-[0.625rem] tracking-[0.14em] text-muted uppercase"
                    >
                        Copy failed
                    </span>
                </span>
            </button>
        </div>
    </div>

    <div
        data-footer-reveal
        class="grid divide-y divide-line border-y border-line sm:grid-cols-3 sm:divide-y-0 sm:border-x"
    >
        {socials.map((social) => (
            <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center justify-between border-line py-5 transition-colors duration-300 hover:bg-bg-raise active:bg-bg-raise sm:border-r sm:px-5 sm:last:border-r-0"
            >
                <div>
                    <p class="text-sm font-medium">{social.label}</p>
                    <p class="font-mono text-[0.6875rem] text-muted">{social.handle}</p>
                </div>
                <span class="sr-only">(opens in new tab)</span>
                <span
                    aria-hidden="true"
                    class="text-muted transition-all duration-300 ease-out-strong group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent group-focus-visible:translate-x-0.5 group-focus-visible:-translate-y-0.5 group-focus-visible:text-accent"
                >
                    ↗
                </span>
            </a>
        ))}
    </div>

    <div class="mt-8 flex flex-col gap-3 sm:border-x sm:border-transparent sm:px-5 md:flex-row md:items-center md:justify-between lg:grid lg:grid-cols-3 lg:gap-0 lg:px-0 *:lg:px-5">
        <p class="meta">
            ©2026 {site.name}
            <span class="max-[359px]:hidden md:max-xl:hidden"> · {site.location}</span>
            <span aria-hidden="true"> · </span>
            <a href="/privacy" class="link-line touch-target text-fg transition-colors duration-200 hover:text-accent">
                Privacy
            </a>
        </p>
        {buildSha && (
            <p class="meta flex items-center gap-1.5">
                <span>Build</span>
                {commitUrl ? (
                    <a
                        href={commitUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="link-line touch-target text-fg transition-colors duration-200 hover:text-accent"
                    >
                        {buildSha}
                        <span class="sr-only">(opens in new tab)</span>
                    </a>
                ) : (
                    <span class="text-fg">{buildSha}</span>
                )}
                {buildDate && (
                    <>
                        <span aria-hidden="true">·</span>
                        <span>{buildDate}</span>
                    </>
                )}
            </p>
        )}
        <div class="flex items-center lg:col-start-3 lg:justify-end">
            <a href="#top" class="link-line touch-target meta inline-block text-fg">
                Back to top <span aria-hidden="true">↑</span>
            </a>
        </div>
    </div>
</footer>

<style>
    /* Pop for state-change feedback (the "Copied" pill) */
    .pop-in {
        animation: pop-in 320ms var(--ease-out-strong) both;
    }

    @keyframes pop-in {
        0% {
            transform: scale(0.5);
            opacity: 0;
        }
        70% {
            transform: scale(1.12);
        }
        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .pop-in {
            animation: none;
        }
    }
</style>

<script>
    import { track } from '../lib/analytics';
    import { gsap, offscreen, prefersReducedMotion } from '../lib/gsap';

    const root = document.querySelector<HTMLElement>('[data-footer]');

    if (root && !prefersReducedMotion()) {
        const [headline] = offscreen(gsap.utils.toArray<HTMLElement>('[data-footer-headline]'));

        if (headline) {
            gsap.set(headline, { y: 0, yPercent: 110 });
            gsap.to(headline, {
                yPercent: 0,
                duration: 1.1,
                ease: 'power4.out',
                scrollTrigger: { trigger: root, start: 'top 75%', once: true },
            });
        }

        const reveals = offscreen(gsap.utils.toArray<HTMLElement>('[data-footer-reveal]'));

        if (reveals.length) {
            gsap.from(reveals, {
                opacity: 0,
                y: 48,
                duration: 1,
                stagger: 0.08,
                scrollTrigger: { trigger: root, start: 'top 75%', once: true },
            });
        }
    }

    const copy = async (text: string) => {
        if (!navigator.clipboard?.writeText) return false;
        await navigator.clipboard.writeText(text);

        return true;
    };

    const btn = document.querySelector<HTMLButtonElement>('[data-copy-email]');

    const def = btn?.querySelector<HTMLElement>('[data-copy-default]');

    const done = btn?.querySelector<HTMLElement>('[data-copy-done]');

    const fail = btn?.querySelector<HTMLElement>('[data-copy-fail]');

    const emailText = btn?.querySelector<HTMLElement>('[data-copy-text]');

    if (btn && def && done && fail) {
        let timer: ReturnType<typeof setTimeout>;

        const selectEmail = () => {
            if (!emailText) return;
            const range = document.createRange();
            range.selectNodeContents(emailText);
            const sel = window.getSelection();
            sel?.removeAllRanges();
            sel?.addRange(range);
        };

        const flash = (ok: boolean) => {
            def.classList.add('hidden');
            done.classList.toggle('hidden', !ok);
            fail.classList.toggle('hidden', ok);
            clearTimeout(timer);
            timer = setTimeout(() => {
                done.classList.add('hidden');
                fail.classList.add('hidden');
                def.classList.remove('hidden');
            }, 2000);
        };

        btn.addEventListener('click', async () => {
            let ok = false;

            try {
                ok = await copy(btn.dataset.email ?? '');
            } catch {
                ok = false;
            }

            if (ok) track('email_copied');
            else selectEmail();
            flash(ok);
        });
    }
</script>
