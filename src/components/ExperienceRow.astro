---
import type { experience } from '../lib/data';

interface Props {
    job: (typeof experience)[number];
    index: number;
    inverted?: boolean;
}

const { job, index, inverted = false } = Astro.props;
const subtle = inverted ? 'text-black/70' : 'text-muted';

const FIGURE = /(P\d+|[~>]?\d[\d.,]*\s?(?:K|M|B|%|ms|s)(?![A-Za-z]))/g;
const splitFigures = (text: string) => text.split(FIGURE);
---

<div
    class="grid gap-3 py-7 lg:grid-cols-[3.5rem_minmax(0,1.2fr)_minmax(0,1.5fr)_11rem] lg:items-baseline lg:gap-8 lg:py-9"
>
    <span class:list={['meta tabular-nums', subtle]}>0{index + 1}</span>
    <div>
        <h3 class="display leading-display text-2xl md:text-3xl">{job.company}</h3>
        <p class:list={['mt-2 font-mono text-xs leading-relaxed tracking-[0.14em] uppercase', subtle]}>
            <span class="block">{job.role}</span>
            <span class="block">{job.type}</span>
        </p>
    </div>
    <ul
        class:list={[
            'max-w-lg space-y-2 text-sm leading-relaxed max-lg:order-last md:text-[0.95rem] lg:max-w-none',
            inverted ? 'text-black/70' : 'text-fg/80',
        ]}
    >
        {
            job.highlights.map((h) => (
                <li>
                    {splitFigures(h).map((part, k) =>
                        k % 2 ? (
                            <strong class:list={['font-semibold', inverted ? 'text-black' : 'text-fg']}>{part}</strong>
                        ) : (
                            part
                        ),
                    )}
                </li>
            ))
        }
    </ul>
    <p
        class:list={[
            'font-mono text-xs leading-relaxed tracking-[0.14em] uppercase lg:text-right',
            inverted ? 'text-black' : 'text-muted',
        ]}
    >
        {job.period.map((range) => <span class="block">{range}</span>)}
    </p>
</div>
