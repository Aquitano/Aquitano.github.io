---
import type { experience } from '../lib/data';

interface Props {
    job: (typeof experience)[number];
}

const { job } = Astro.props;

const [primary, ...details] = job.highlights;

const FIGURE = /(P\d+|[~>]?\d[\d.,]*\s?(?:K|M|B|%|ms|s)(?![A-Za-z]))/g;

const splitFigures = (text: string) => text.split(FIGURE);
---

<div class="grid gap-3 py-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.7fr)_11rem] lg:items-baseline lg:gap-8 lg:py-9">
    <div>
        <h3 class="heading text-2xl md:text-3xl">{job.company}</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">
            <span class="block">{job.role}</span>
            <span class="block">{job.type}</span>
        </p>
    </div>
    <div class="max-w-xl text-sm leading-relaxed text-fg/80 max-lg:order-last md:text-[0.95rem] lg:max-w-none">
        <p>
            {splitFigures(primary).map((part, k) =>
                k % 2 ? <strong class="font-semibold text-fg">{part}</strong> : part,
            )}
        </p>
        <details class="mt-4">
            <summary class="w-fit cursor-pointer py-2 text-xs text-muted transition-colors hover:text-fg">
                Implementation details
            </summary>
            <ul class="mt-3 space-y-3 border-l border-line pl-4">
                {details.map((highlight) => (
                    <li>
                        {splitFigures(highlight).map((part, k) =>
                            k % 2 ? <strong class="font-semibold text-fg">{part}</strong> : part,
                        )}
                    </li>
                ))}
            </ul>
        </details>
    </div>
    <p class:list={['font-mono text-xs leading-relaxed tracking-[0.14em] uppercase lg:text-right', 'text-muted']}>
        {job.period.map((range) => (
            <span class="block">{range}</span>
        ))}
    </p>
</div>
