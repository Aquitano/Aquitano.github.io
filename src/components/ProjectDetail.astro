---
import { isExternalHref } from '../lib/links';

interface DetailProject {
    title: string;
    wrap?: string[];
    subtitle: string;
    year: string;
    description: string;
    tags: string[];
    tasks: string[];
    links: { label: string; href: string; external?: boolean }[];
    accent: string;
    image?: string;
}

interface Props {
    project: DetailProject;
    index: number;
    total: number;
    next: { title: string; wrap?: string[]; slug: string; accent: string };
}

const { project, index, total, next } = Astro.props;
const titleLines = project.wrap ?? [project.title];
const nextLines = next.wrap ?? [next.title];

const LINE_STAGGER = 80;
const FADE_STAGGER = 60;
const fadeStart = 700 + (titleLines.length - 1) * LINE_STAGGER;
const fadeDelay = (i: number) => `--intro-delay: ${fadeStart + i * FADE_STAGGER}ms`;
---

<div id="top" data-detail class="relative overflow-x-clip">
    {/* per-project glow */}
    <div
        class="pointer-events-none absolute top-0 -right-1/4 h-[60svh] w-[70%] rounded-full opacity-[0.1] blur-3xl"
        style={`background: ${project.accent}`}
        aria-hidden="true"
    >
    </div>

    <header class="section-x relative pt-28 pb-12 md:pt-40 md:pb-16">
        <div class="intro-fade" style={fadeDelay(0)}>
            <a href="/#work" class="link-line pressable touch-target meta text-fg inline-block">← All Work</a>
        </div>

        <div class="mt-10 flex items-baseline justify-between gap-4 md:mt-14">
            <p class="intro-fade meta flex items-center gap-2" style={fadeDelay(1)}>
                <span
                    class="inline-block h-1.5 w-1.5 shrink-0 rounded-full"
                    style={`background: ${project.accent}`}
                    aria-hidden="true"></span>
                {project.subtitle}
            </p>
            <p class="intro-fade meta" style={fadeDelay(2)}>©{project.year} · 0{index + 1}/0{total}</p>
        </div>

        <h1 class="display mt-4 text-[clamp(2.25rem,11vw,10.5rem)]">
            {
                titleLines.map((line, i) => (
                    <span class="block overflow-hidden pb-[0.06em]">
                        <span class="intro-rise block" style={`--intro-delay: ${100 + i * LINE_STAGGER}ms`}>
                            {line}
                        </span>
                    </span>
                ))
            }
        </h1>

        <p class="intro-fade text-muted mt-8 max-w-3xl text-base leading-relaxed md:text-xl" style={fadeDelay(3)}>
            {project.description}
        </p>
    </header>
    {
        project.image && (
            <div data-detail-banner class="section-x relative pt-2 pb-10 md:pb-16">
                <div class="border-line relative overflow-hidden rounded-2xl border">
                    <div
                        class="pointer-events-none absolute -top-1/3 -right-1/4 h-[70%] w-[70%] rounded-full opacity-[0.08] blur-3xl"
                        style={`background: ${project.accent}`}
                        aria-hidden="true"
                    />
                    <div class="relative aspect-[16/9] w-full">
                        <img
                            src={project.image}
                            alt={`${project.title} — ${project.subtitle}`}
                            loading="eager"
                            class="absolute inset-x-0 -top-[8%] h-[116%] w-full object-cover"
                        />
                    </div>
                </div>
            </div>
        )
    }

    <div
        data-detail-body
        class="border-line section-x relative grid gap-12 border-t py-16 md:py-24 lg:grid-cols-[minmax(16rem,1fr)_2fr] lg:gap-20"
    >
        <aside class="lg:sticky lg:top-28 lg:self-start">
            <dl class="space-y-8">
                <div data-detail-para>
                    <dt class="meta mb-2">Scope</dt>
                    <dd class="text-fg/85 font-mono text-sm leading-relaxed">{project.tasks.join(' · ')}</dd>
                </div>
                <div data-detail-para>
                    <dt class="meta mb-3">Stack</dt>
                    <dd>
                        <ul class="flex flex-wrap gap-2">
                            {
                                project.tags.map((tag) => (
                                    <li class="border-line text-fg/70 hover:border-accent/60 hover:text-accent ease-out-strong rounded-full border px-3 py-1 font-mono text-[0.625rem] tracking-[0.14em] uppercase transition-all duration-300 hover:-translate-y-0.5">
                                        {tag}
                                    </li>
                                ))
                            }
                        </ul>
                    </dd>
                </div>
                {
                    project.links.length > 0 && (
                        <div data-detail-para>
                            <dt class="meta mb-3">Links</dt>
                            <dd class="flex flex-col items-start gap-3">
                                {project.links.map((link) => (
                                    <a
                                        href={link.href}
                                        target={link.external || isExternalHref(link.href) ? '_blank' : undefined}
                                        rel={
                                            link.external || isExternalHref(link.href)
                                                ? 'noopener noreferrer'
                                                : undefined
                                        }
                                        class="link-line pressable touch-target text-fg font-mono text-xs tracking-[0.14em] uppercase"
                                    >
                                        {link.label} ↗
                                    </a>
                                ))}
                            </dd>
                        </div>
                    )
                }
            </dl>
        </aside>

        <div
            data-detail-prose
            class="[&>p]:text-fg/85 [&_code]:bg-bg-raise [&_code]:border-line max-w-xl space-y-6 [&_code]:rounded [&_code]:border [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:text-[0.85em] [&>p]:text-base [&>p]:leading-relaxed md:[&>p]:text-lg"
        >
            <slot />
        </div>
    </div>

    <a
        href={`/work/${next.slug}`}
        data-detail-next
        class="group border-line section-x relative block overflow-hidden border-t py-16 md:py-24"
    >
        <div
            class="pointer-events-none absolute -top-1/2 -right-1/4 h-[140%] w-[60%] rounded-full opacity-0 blur-3xl transition-opacity duration-500 group-hover:opacity-[0.12]"
            style={`background: ${next.accent}`}
            aria-hidden="true"
        >
        </div>
        <p class="meta relative mb-4">Next Project</p>
        <p
            class="display group-hover:text-accent relative text-[clamp(1.9rem,8vw,7rem)] transition-colors duration-300"
        >
            {
                nextLines.map((part, j) => {
                    if (j < nextLines.length - 1) {
                        return (
                            <Fragment>
                                {part}
                                <wbr />
                            </Fragment>
                        );
                    }
                    // Bind only the last word to the arrow so a long final segment can still wrap.
                    const words = part.split(' ');
                    const lastWord = words.pop();
                    return (
                        <Fragment>
                            {words.length > 0 && `${words.join(' ')} `}
                            <span class="whitespace-nowrap">
                                {lastWord}
                                <span class="display-outline ease-out-strong ml-[0.15em] inline-block align-baseline text-[0.55em] transition-transform duration-300 group-hover:translate-x-[0.1em] group-hover:-translate-y-[0.1em]">
                                    →
                                </span>
                            </span>
                        </Fragment>
                    );
                })
            }
        </p>
    </a>
</div>

<script>
    import { gsap, ScrollTrigger, prefersReducedMotion } from '../lib/gsap';

    const root = document.querySelector<HTMLElement>('[data-detail]');
    if (root && !prefersReducedMotion()) {
        // Anything already painted on screen stays put rather than blinking out and back in.
        const offscreen = (els: Element[]) => els.filter((el) => !ScrollTrigger.isInViewport(el));

        const banner = root.querySelector<HTMLElement>('[data-detail-banner]');
        if (banner) {
            const [frame] = offscreen([...banner.children]);
            if (frame) {
                gsap.from(frame, {
                    opacity: 0,
                    y: 48,
                    duration: 1,
                    ease: 'power3.out',
                    scrollTrigger: { trigger: banner, start: 'top 90%', once: true },
                });
            }
            gsap.fromTo(
                banner.querySelector('img'),
                { yPercent: -6 },
                {
                    yPercent: 6,
                    ease: 'none',
                    scrollTrigger: { trigger: banner, start: 'top bottom', end: 'bottom top', scrub: true },
                },
            );
        }

        const revealItems = offscreen([
            ...root.querySelectorAll('[data-detail-para]'),
            ...root.querySelectorAll('[data-detail-prose] > *'),
            ...root.querySelectorAll('[data-detail-next]'),
        ]);
        gsap.set(revealItems, { opacity: 0, y: 32 });
        ScrollTrigger.batch(revealItems, {
            start: 'top 88%',
            once: true,
            onEnter: (batch) => gsap.to(batch, { opacity: 1, y: 0, duration: 0.9, stagger: 0.1 }),
        });
    }
</script>
