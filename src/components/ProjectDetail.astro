---
import { Picture } from 'astro:assets';
import ReconciliationDemo from './ReconciliationDemo.astro';
import RestoreRecord from './RestoreRecord.astro';
import type { CollectionEntry } from 'astro:content';
import { isExternalHref } from '../lib/links';

interface Props {
    project: CollectionEntry<'work'>['data'];
    index: number;
    total: number;
    next: { title: string; wrap?: string[]; slug: string; accent: string };
}

const { project, index, total, next } = Astro.props;

const opensNewTab = (link: (typeof project.links)[number]) => link.external || isExternalHref(link.href);

const titleParts = project.title.includes(' ')
    ? [project.title]
    : (project.wrap ?? project.title.split(/(?<=[a-z])(?=[A-Z])/));

const nextParts = next.title.includes(' ') ? [next.title] : (next.wrap ?? next.title.split(/(?<=[a-z])(?=[A-Z])/));
---

<div id="top" data-detail>
    <div class:list={[['Griffin Energy', 'ChillFlow', 'FrontiersToSpace'].includes(project.title) && 'split-intro']}>
        <header class="section-x pt-28 pb-10 md:pt-36 md:pb-12">
            <a href="/#work" class="link-line touch-target text-sm text-muted hover:text-fg">
                <span aria-hidden="true">←</span> All work
            </a>
            <div class="mt-8 flex items-baseline justify-between gap-4 md:mt-10">
                <p class="text-sm text-muted">{project.subtitle}</p>
                <p class="shrink-0 font-mono text-xs text-muted">
                    {project.year}{' '}
                    <span class="max-[359px]:hidden">
                        · {index + 1}/{total}
                    </span>
                </p>
            </div>
            <h1 class="heading case-title mt-5" aria-label={project.title}>
                {titleParts.map((part, i) => (
                    <Fragment>
                        {i > 0 && <wbr />}
                        {part}
                    </Fragment>
                ))}
            </h1>
            <p class="mt-6 max-w-3xl text-base leading-relaxed text-muted md:text-xl">{project.summary}</p>
        </header>
        <div class="section-x pb-12 md:pb-16">
            {project.title === 'aqt-sync' ? (
                <RestoreRecord />
            ) : project.title === 'aqt-health' ? (
                <ReconciliationDemo />
            ) : project.title === 'Griffin Energy' ? (
                <figure class="historical-interface product-render overflow-hidden rounded-xl border border-line">
                    <div class="bg-[#f6f6f3] p-6 md:p-10">
                        <img
                            src="/showcase/griffin/images/untitled2.png"
                            alt="Original Blender render of both Griffin Energy variants."
                            width="826"
                            height="1002"
                            class="mx-auto max-h-[32rem] w-full object-contain"
                        />
                    </div>
                    <figcaption class="border-t border-line bg-bg-raise px-5 py-4 text-[0.8125rem] text-muted">
                        Original product render, created in Blender.
                    </figcaption>
                </figure>
            ) : (
                project.image && (
                    <figure
                        class:list={[
                            'historical-interface overflow-hidden rounded-xl border border-line',
                            project.title === 'ChillFlow' && 'landing-interface',
                            project.title === 'FrontiersToSpace' && 'mission-interface',
                        ]}
                    >
                        <div class:list={[project.title === 'ChillFlow' && 'interface-crop']}>
                            <Picture
                                src={project.image}
                                formats={['avif', 'webp']}
                                alt={project.imageAlt ?? `${project.title}: ${project.subtitle}`}
                                widths={[640, 960, 1280, 1920, 2400]}
                                sizes={
                                    project.title === 'ChillFlow'
                                        ? '(min-width:1008px) 2400px, 260vw'
                                        : '(min-width:1008px) 928px, calc(100vw - 2.5rem)'
                                }
                                priority
                                class="block h-auto w-full"
                            />
                        </div>
                        {project.title === 'ChillFlow' && (
                            <figcaption class="border-t border-line bg-bg-raise px-5 py-4 text-[0.8125rem] text-muted">
                                Original 2025 landing page, cropped from the supplied render. The hosted demo is
                                unavailable.
                            </figcaption>
                        )}
                        {project.title === 'BetterGaming' && (
                            <figcaption class="border-t border-line bg-bg-raise px-5 py-4 text-[0.8125rem] text-muted">
                                Search for “Assassin”, sorted by price in the public demo. Captured results:
                                <ol
                                    aria-label="Captured results in ascending price order"
                                    class="mt-4 grid gap-3 text-sm text-fg sm:grid-cols-3 sm:gap-x-6"
                                >
                                    {[
                                        { title: 'Assassins Creed Origins', price: '9.89€' },
                                        { title: 'Assassins Creed Odyssey', price: '11.99€' },
                                        { title: 'Assassins Creed Valhalla', price: '34.78€' },
                                    ].map((result) => (
                                        <li class="flex justify-between gap-4 sm:flex-col sm:gap-1">
                                            <span>{result.title}</span>
                                            <span class="font-mono text-[0.8125rem] text-muted">{result.price}</span>
                                        </li>
                                    ))}
                                </ol>
                            </figcaption>
                        )}
                        {project.title === 'FrontiersToSpace' && (
                            <figcaption class="flex flex-wrap items-center justify-between gap-x-5 gap-y-1 border-t border-line bg-bg-raise px-5 py-2 text-[0.8125rem] text-muted">
                                <span>
                                    Original 2023 dashboard, in German. The map is framed around the recorded route.
                                </span>
                                <a
                                    class="link-line touch-target"
                                    href="https://www.openstreetmap.org/copyright"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    Map data © OpenStreetMap contributors <span aria-hidden="true">↗</span>
                                    <span class="sr-only"> (opens in new tab)</span>
                                </a>
                            </figcaption>
                        )}
                    </figure>
                )
            )}
        </div>
    </div>
    <div class="section-x case-body border-t border-line py-12 md:py-16">
        <aside>
            <dl class="grid grid-cols-2 gap-6 lg:sticky lg:top-28 lg:grid-cols-1">
                <div>
                    <dt class="mb-2 text-xs text-muted">Scope</dt>
                    <dd class="text-sm leading-relaxed text-fg/85">{project.tasks.join(', ')}</dd>
                </div>
                <div>
                    <dt class="mb-2 text-xs text-muted">Stack</dt>
                    <dd class="text-sm leading-relaxed text-fg/85">{project.tags.join(', ')}</dd>
                </div>
                {project.links.length > 0 && (
                    <div class="col-span-2 lg:col-span-1">
                        <dt class="mb-2 text-xs text-muted">Explore</dt>
                        <dd class="flex flex-wrap items-start gap-x-5 gap-y-1">
                            {project.links.map((link) => (
                                <a
                                    href={link.href}
                                    target={opensNewTab(link) ? '_blank' : undefined}
                                    rel={opensNewTab(link) ? 'noopener noreferrer' : undefined}
                                    class="link-line touch-target text-sm text-fg hover:text-accent"
                                >
                                    {link.label} <span aria-hidden="true">{opensNewTab(link) ? '↗' : '→'}</span>
                                    {opensNewTab(link) && <span class="sr-only"> (opens in new tab)</span>}
                                </a>
                            ))}
                        </dd>
                    </div>
                )}
            </dl>
        </aside>
        <article class="case-prose">
            <slot />
        </article>
    </div>
    <slot name="evidence" />
    <a
        href={`/work/${next.slug}`}
        class="group section-x block border-t border-line py-12 focus-visible:-outline-offset-4 md:py-16"
    >
        <p class="mb-4 text-xs text-muted">Next project</p>
        <p
            class="heading text-[clamp(1.9rem,5vw,4rem)] transition-colors group-hover:text-accent group-focus-visible:text-accent"
            aria-label={next.title}
        >
            {nextParts.map((part, i) => (
                <Fragment>
                    {i > 0 && <wbr />}
                    {part}
                </Fragment>
            ))}{' '}
            <span aria-hidden="true" class="inline-block text-[0.65em]">
                →
            </span>
        </p>
    </a>
</div>
<style>
    @media (min-width: 1024px) {
        .split-intro {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            padding: 9rem max(2.5rem, calc((100% - 96rem) / 2)) 4rem;
        }
        .split-intro > header,
        .split-intro > div {
            padding: 0;
        }
        .split-intro .product-render {
            max-width: none;
        }
    }
    .historical-interface {
        max-width: 58rem;
        margin-inline: 0;
    }
    .landing-interface {
        max-width: 28rem;
    }
    .mission-interface {
        max-width: 40rem;
    }
    .interface-crop {
        position: relative;
        aspect-ratio: 915 / 400;
        overflow: hidden;
    }
    .interface-crop :global(img) {
        position: absolute;
        width: 262.3%;
        max-width: none;
        height: auto;
        left: -93.77%;
        top: -97.5%;
    }
    .case-title {
        font-size: clamp(2.5rem, 7vw, 6rem);
        letter-spacing: -0.04em;
    }
    .case-body {
        display: grid;
        gap: 2.5rem;
    }
    .case-prose {
        font-size: 1rem;
        line-height: 1.75;
        color: color-mix(in oklch, var(--fg) 85%, transparent);
    }
    .case-prose :global(h2) {
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        color: var(--fg);
        font-size: 1.5rem;
        line-height: 1.25;
        font-weight: 600;
        letter-spacing: -0.02em;
    }
    .case-prose :global(h2:first-child) {
        margin-top: 0;
    }
    .case-prose :global(p + p) {
        margin-top: 1.25rem;
    }
    .case-prose :global(code) {
        border-radius: 0.25rem;
        border: 1px solid var(--line);
        background: var(--bg-raise);
        padding: 0.125rem 0.375rem;
        font-size: 0.85em;
    }
    @media (min-width: 1024px) {
        .case-body {
            grid-template-columns: 16rem minmax(0, 42rem);
            gap: 4rem;
        }
        .case-prose {
            font-size: 1.125rem;
        }
    }
</style>
