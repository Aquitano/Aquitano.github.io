---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { isExternalHref } from '../lib/links';
import { displayTitle, opticalIndent } from '../lib/displayTitle';

interface Props {
    project: CollectionEntry<'work'>['data'];
    index: number;
    total: number;
    next: { title: string; wrap?: string[]; slug: string; accent: string };
}

const { project, index, total, next } = Astro.props;

const title = displayTitle(project.title, project.wrap);

const nextTitle = displayTitle(next.title, next.wrap);

const opensNewTab = (link: (typeof project.links)[number]) => link.external || isExternalHref(link.href);

const LINE_STAGGER = 80;

const FADE_STAGGER = 60;

const fadeStart = 700 + (title.lines.length - 1) * LINE_STAGGER;

const fadeDelay = (i: number) => `--intro-delay: ${fadeStart + i * FADE_STAGGER}ms`;
---

<div id="top" data-detail class="relative overflow-x-clip">
    {/* per-project glow */}
    <div
        class="pointer-events-none absolute top-0 -right-1/4 h-[60svh] w-[70%] rounded-full opacity-[0.1] blur-3xl"
        style={`background: ${project.accent}`}
        aria-hidden="true"
    ></div>

    <header class="section-x relative pt-28 pb-12 md:pt-40 md:pb-16">
        <div class="intro-fade" style={fadeDelay(0)}>
            <a href="/#work" class="link-line pressable touch-target meta inline-block text-fg">
                <span aria-hidden="true">←</span> All Work
            </a>
        </div>

        <div class="mt-10 flex items-baseline justify-between gap-4 md:mt-14">
            <p class="intro-fade meta flex items-baseline gap-2" style={fadeDelay(1)}>
                <span
                    class="inline-block h-1.5 w-1.5 shrink-0 self-center rounded-full"
                    style={`background: ${project.accent}`}
                    aria-hidden="true"
                ></span>
                {project.subtitle}
            </p>
            <p class="intro-fade meta whitespace-nowrap" style={fadeDelay(2)}>
                ©{project.year}
                <span class="max-[359px]:hidden">
                    {' '}
                    · 0{index + 1}/0{total}
                </span>
            </p>
        </div>

        <h1 class="display mt-4 text-[clamp(2.25rem,11.5vw,11rem)]">
            {title.lines.map((words, i) => (
                <span class="block overflow-y-clip pb-[0.06em]">
                    <span
                        class="intro-rise block"
                        style={`--intro-delay: ${100 + i * LINE_STAGGER}ms; ${opticalIndent(words[0].text)}`}
                    >
                        {words.map(({ text, outline }) => (
                            <span class:list={{ 'display-outline': outline }}>{text}</span>
                        ))}
                    </span>
                </span>
            ))}
        </h1>

        <p class="intro-fade mt-8 max-w-2xl text-base leading-relaxed text-muted md:text-xl" style={fadeDelay(3)}>
            {project.description}
        </p>
    </header>
    {project.image && (
        <div data-detail-banner class="section-x relative pt-2 pb-10 md:pb-16">
            <div class="relative overflow-hidden rounded-2xl border border-line">
                <div
                    class="pointer-events-none absolute -top-1/3 -right-1/4 h-[70%] w-[70%] rounded-full opacity-[0.08] blur-3xl"
                    style={`background: ${project.accent}`}
                    aria-hidden="true"
                />
                <div class="relative aspect-[16/9] w-full">
                    <Picture
                        src={project.image}
                        formats={['avif', 'webp']}
                        alt={`${project.title} — ${project.subtitle}`}
                        widths={[640, 960, 1280, 1600, 2400]}
                        sizes="(min-width: 1616px) 1770px, (min-width: 768px) calc((100vw - 5rem) * 1.15), calc((100vw - 2.5rem) * 1.15)"
                        priority
                        class="absolute inset-x-0 -top-[8%] h-[116%] w-full object-cover"
                    />
                </div>
            </div>
        </div>
    )}

    <div
        data-detail-body
        class="section-x relative grid gap-12 border-t border-line py-16 md:py-24 lg:grid-cols-[minmax(16rem,1fr)_2fr] lg:gap-8"
    >
        <aside class="lg:sticky lg:top-28 lg:self-start">
            <dl class="space-y-8">
                <div data-detail-para>
                    <dt class="meta mb-2">Scope</dt>
                    <dd class="overflow-hidden">
                        {/* Each item carries its own separator; pulling the list left clips the one starting each line. */}
                        <ul class="-ml-6 flex flex-wrap font-mono text-sm leading-relaxed text-fg/85">
                            {project.tasks.map((task) => (
                                <li class="relative pl-6 whitespace-nowrap">
                                    <span aria-hidden="true" class="absolute left-0 w-6 text-center text-muted">
                                        ·
                                    </span>
                                    {task}
                                </li>
                            ))}
                        </ul>
                    </dd>
                </div>
                <div data-detail-para>
                    <dt class="meta mb-3">Stack</dt>
                    <dd>
                        <ul class="flex flex-wrap gap-2">
                            {project.tags.map((tag) => (
                                <li class="rounded-full border border-line px-3 py-1 font-mono text-[0.625rem] tracking-[0.14em] text-fg/70 uppercase">
                                    {tag}
                                </li>
                            ))}
                        </ul>
                    </dd>
                </div>
                {project.links.length > 0 && (
                    <div data-detail-para>
                        <dt class="meta mb-3">Links</dt>
                        <dd class="flex flex-col items-start gap-3 pointer-coarse:gap-7">
                            {project.links.map((link) => (
                                <a
                                    href={link.href}
                                    target={opensNewTab(link) ? '_blank' : undefined}
                                    rel={opensNewTab(link) ? 'noopener noreferrer' : undefined}
                                    class="link-line pressable touch-target font-mono text-xs tracking-[0.14em] text-fg uppercase"
                                >
                                    {link.label} <span aria-hidden="true">↗</span>
                                    {opensNewTab(link) && <span class="sr-only">(opens in new tab)</span>}
                                </a>
                            ))}
                        </dd>
                    </div>
                )}
            </dl>
        </aside>

        <div
            data-detail-prose
            class="max-w-xl space-y-6 [&_code]:rounded [&_code]:border [&_code]:border-line [&_code]:bg-bg-raise [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:text-[0.85em] [&>p]:text-base [&>p]:leading-relaxed [&>p]:text-fg/85 md:[&>p]:text-lg"
        >
            <slot />
        </div>
    </div>

    <a
        href={`/work/${next.slug}`}
        data-detail-next
        class="group section-x relative block overflow-hidden border-t border-line py-16 focus-visible:-outline-offset-4 md:py-24"
    >
        <div
            class="pointer-events-none absolute -top-1/2 -right-1/4 h-[140%] w-[60%] rounded-full opacity-0 blur-3xl transition-opacity duration-500 group-hover:opacity-[0.12] group-focus-visible:opacity-[0.12]"
            style={`background: ${next.accent}`}
            aria-hidden="true"
        ></div>
        <p class="meta relative mb-4">Next Project</p>
        <p class="display relative text-[clamp(1.9rem,8vw,7rem)] transition-colors duration-300 group-hover:text-accent group-focus-visible:text-accent">
            {nextTitle.lines.map((words, j) => (
                <Fragment>
                    {j > 0 && (nextTitle.joiner || <wbr />)}
                    {words.map(({ text, outline }, k) => {
                        const word = (
                            <span
                                class:list={{ 'display-outline': outline }}
                                style={j === 0 && k === 0 ? opticalIndent(text) : undefined}
                            >
                                {text}
                            </span>
                        );
                        if (j < nextTitle.lines.length - 1 || k < words.length - 1) return word;
                        // Bind only the last word to the arrow so a long title can still wrap.
                        return (
                            <span class="whitespace-nowrap">
                                {word}
                                <span
                                    aria-hidden="true"
                                    class="ml-[0.15em] inline-block align-baseline text-[0.55em] transition-transform duration-300 ease-out-strong group-hover:translate-x-[0.1em] group-hover:-translate-y-[0.1em] group-focus-visible:translate-x-[0.1em] group-focus-visible:-translate-y-[0.1em]"
                                >
                                    →
                                </span>
                            </span>
                        );
                    })}
                </Fragment>
            ))}
        </p>
    </a>
</div>

<script>
    import { gsap, ScrollTrigger, offscreen, prefersReducedMotion } from '../lib/gsap';

    const root = document.querySelector<HTMLElement>('[data-detail]');

    if (root && !prefersReducedMotion()) {
        const banner = root.querySelector<HTMLElement>('[data-detail-banner]');

        if (banner) {
            const [frame] = offscreen([...banner.children]);

            if (frame) {
                gsap.from(frame, {
                    opacity: 0,
                    y: 48,
                    duration: 1,
                    ease: 'power3.out',
                    scrollTrigger: { trigger: banner, start: 'top 90%', once: true },
                });
            }

            gsap.fromTo(
                banner.querySelector('img'),
                { yPercent: -6 },
                {
                    yPercent: 6,
                    ease: 'none',
                    scrollTrigger: { trigger: banner, start: 'top bottom', end: 'bottom top', scrub: true },
                },
            );
        }

        const revealItems = offscreen([
            ...root.querySelectorAll('[data-detail-para]'),
            ...root.querySelectorAll('[data-detail-prose] > *'),
            ...root.querySelectorAll('[data-detail-next]'),
        ]);

        gsap.set(revealItems, { opacity: 0, y: 32 });
        ScrollTrigger.batch(revealItems, {
            start: 'top 88%',
            once: true,
            onEnter: (batch) => gsap.to(batch, { opacity: 1, y: 0, duration: 0.9, stagger: 0.1 }),
        });
    }
</script>
