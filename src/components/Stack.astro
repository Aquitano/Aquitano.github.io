---
import { languages, stack } from '../lib/data';
import SectionHeading from './SectionHeading.astro';
---

<section id="stack" data-stack-section data-minimap="Stack" class="section-x section-y">
    <SectionHeading index="05" title="Stack" />
    <dl class="grid gap-x-12 gap-y-6 md:grid-cols-2">
        {stack.map((group) => (
            <div data-stack-col>
                <dt class="mb-2 text-sm font-medium text-fg">{group.label}</dt>
                <dd class="text-sm leading-relaxed text-muted">{group.items.join(', ')}</dd>
            </div>
        ))}
    </dl>
    <div data-stack-col class="mt-10 flex items-baseline gap-x-8 border-t border-line pt-6">
        <span class="meta">Spoken</span>
        <div class="flex flex-col gap-x-8 gap-y-2 sm:flex-row sm:flex-wrap">
            {languages.map((lang) => (
                <span class="font-mono text-xs text-fg/85">
                    {lang.label} <span class="text-muted">· {lang.level}</span>
                </span>
            ))}
        </div>
    </div>
</section>

<script>
    import { gsap, offscreen, prefersReducedMotion } from '../lib/gsap';

    const root = document.querySelector<HTMLElement>('[data-stack-section]');

    const items = offscreen(gsap.utils.toArray<HTMLElement>('[data-stack-col] > *'));

    if (root && items.length && !prefersReducedMotion()) {
        gsap.from(items, {
            opacity: 0,
            y: 32,
            stagger: 0.07,
            scrollTrigger: { trigger: root, start: 'top 80%', once: true },
        });
    }
</script>
