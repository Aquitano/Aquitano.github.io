---
import { languages, stack } from '../lib/data';
import SectionHeading from './SectionHeading.astro';
---

<section id="stack" data-stack-section data-minimap="Stack" class="section-x section-y">
    <SectionHeading index="04" title="Stack" />
    <div class="grid grid-cols-2 gap-px overflow-hidden border border-line bg-line lg:grid-cols-4">
        {stack.map((group) => (
            <div data-stack-col class="bg-bg px-5 py-6 md:p-8">
                <h3 class="meta mb-5 text-accent">{group.label}</h3>
                <ul class="space-y-2">
                    {group.items.map((item) => (
                        <li class="group/item flex items-center text-sm text-fg/85 transition-colors duration-200 hover:text-fg md:text-base">
                            <span
                                aria-hidden="true"
                                class="inline-block w-0 overflow-hidden text-accent opacity-0 transition-all duration-300 ease-out-strong group-hover/item:w-5 group-hover/item:opacity-100"
                            >
                                ✦
                            </span>
                            {item}
                        </li>
                    ))}
                </ul>
            </div>
        ))}
    </div>
    <div data-stack-col class="flex items-baseline gap-x-8 border border-t-0 border-line px-5 py-5 md:px-8">
        <span class="meta">Spoken</span>
        <div class="flex flex-col gap-x-8 gap-y-2 sm:flex-row sm:flex-wrap">
            {languages.map((lang) => (
                <span class="font-mono text-xs text-fg/85">
                    {lang.label} <span class="text-muted">· {lang.level}</span>
                </span>
            ))}
        </div>
    </div>
</section>

<script>
    import { gsap, offscreen, prefersReducedMotion } from '../lib/gsap';

    const root = document.querySelector<HTMLElement>('[data-stack-section]');

    const items = offscreen(gsap.utils.toArray<HTMLElement>('[data-stack-col] > *'));

    if (root && items.length && !prefersReducedMotion()) {
        gsap.from(items, {
            opacity: 0,
            y: 32,
            stagger: 0.07,
            scrollTrigger: { trigger: root, start: 'top 80%', once: true },
        });
    }
</script>
