---
import { reconciliationRules as rules } from '../lib/reconciliation';
import ProviderTracks from './ProviderTracks.astro';
---

<figure class="policy-demo">
    <figcaption class="mb-4 md:mb-6">
        <p class="mb-2 text-xs text-muted">Canonical metrics</p>
        <h2 class="text-xl font-medium tracking-tight md:text-3xl">Two sources, one read.</h2>
    </figcaption>
    <div class="policy-content">
        <fieldset class="policy-selector">
            <legend class="sr-only">Metric policy</legend>
            {rules.map((rule, i) => (
                <label class="policy-option">
                    <input
                        type="radio"
                        name="canonical-policy"
                        value={rule.id}
                        checked={i === 0}
                        aria-controls={`${rule.id}-policy-panel`}
                    />
                    <span>{rule.label}</span>
                </label>
            ))}
        </fieldset>
        {rules.map((rule) => (
            <div class="policy-panel" data-policy={rule.id} id={`${rule.id}-policy-panel`}>
                <ProviderTracks rule={rule} compact />
                <div class="policy-result" id={`${rule.id}-policy-result`}>
                    <h3 class="text-xl font-medium tracking-tight">{rule.result}</h3>
                    <p class="mt-3 text-sm leading-relaxed text-fg/80">{rule.policy}</p>
                </div>
            </div>
        ))}
    </div>
    <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-policy-announcement></p>
    <p class="mt-4 border-t border-[#59404c] pt-3 text-[0.8125rem] leading-relaxed text-muted">
        Schematic records, not patient data.
    </p>
    <a
        class="link-line touch-target mt-1 text-sm text-fg/80 hover:text-fg"
        href="https://github.com/Aquitano/aqt-health/blob/6e4f4ea48a3b7616042a1f8e16c80abc2b5838e7/README.md#canonical-metrics"
        target="_blank"
        rel="noopener noreferrer"
    >
        Read the documented rules <span aria-hidden="true">↗</span>
        <span class="sr-only"> (opens in new tab)</span>
    </a>
</figure>
<style>
    .policy-demo {
        padding: clamp(1.25rem, 4vw, 3rem);
        border: 1px solid #59404c;
        border-radius: 0.75rem;
        background: #171216;
    }
    .policy-content {
        display: grid;
    }
    .policy-selector {
        grid-area: 1 / 1;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 2rem;
    }
    .policy-option {
        position: relative;
        cursor: pointer;
    }
    .policy-option input {
        position: absolute;
        opacity: 0;
        width: 1px;
        height: 1px;
    }
    .policy-option > span {
        display: grid;
        min-height: 44px;
        place-items: center;
        border: 1px solid #59404c;
        border-radius: 0.375rem;
        padding: 0.5rem 1rem;
        font-size: 0.875rem;
    }
    .policy-option input:checked + span {
        border-color: #d4a7bc;
        background: #39232f;
        color: #fff;
    }
    .policy-option input:focus-visible + span {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
    }
    .policy-panel {
        display: grid;
        grid-area: 2 / 1;
        visibility: hidden;
        gap: 2rem;
        align-items: center;
    }
    .policy-content:has(input[value='steps']:checked) [data-policy='steps'],
    .policy-content:has(input[value='sleep']:checked) [data-policy='sleep'],
    .policy-content:has(input[value='heart']:checked) [data-policy='heart'] {
        visibility: visible;
    }
    .policy-result {
        border-left: 2px solid #b78199;
        padding-left: 1.5rem;
    }
    @media (max-width: 767px) {
        .policy-selector {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 0.375rem;
            margin-bottom: 1rem;
        }
        .policy-option > span {
            padding-inline: 0.375rem;
            white-space: nowrap;
        }
        .policy-panel {
            gap: 1rem;
        }
        .policy-result {
            border-left: 0;
            border-top: 1px solid #59404c;
            padding-left: 0;
            padding-top: 0.75rem;
        }
    }
    @media (min-width: 768px) {
        .policy-panel {
            grid-template-columns: 1.1fr 1fr;
            gap: 3rem;
        }
    }
</style>

<script>
    const announcement = document.querySelector<HTMLElement>('[data-policy-announcement]');

    for (const input of document.querySelectorAll<HTMLInputElement>('input[name="canonical-policy"]')) {
        input.addEventListener('change', () => {
            const result = document.getElementById(`${input.value}-policy-result`);

            if (announcement && result) announcement.textContent = result.innerText;
        });
    }
</script>
