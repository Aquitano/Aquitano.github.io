---
import { site } from '../lib/data';
import RetentionStudy from './RetentionStudy.astro';
---

<section id="top" data-hero data-minimap="Intro" class="section-x hero">
    <div class="hero-intro">
        <div class="hero-identity">
            <p class="mb-3 text-sm text-muted md:mb-5">{site.role}</p>
            <h1 class="heading hero-name">
                Thomas <br class="hidden lg:block" />
                Breindl
            </h1>
            <p class="hero-summary mt-3 max-w-sm text-base leading-relaxed text-muted md:mt-6">
                Backend systems and interfaces. Studying computer science in {site.location}.
            </p>
            <div class="hero-actions mt-4 flex flex-wrap items-center gap-x-4 gap-y-3 md:mt-7 md:gap-6">
                <a href="#work" class="action-link">
                    Explore my work <span aria-hidden="true">↘</span>
                </a>
                <a href="#contact" class="link-line touch-target text-sm text-muted transition-colors hover:text-fg">
                    Get in touch
                </a>
                <div data-hero-tools class="hero-tools"></div>
            </div>
        </div>
        <RetentionStudy />
    </div>
</section>

<style>
    .hero {
        padding-top: clamp(7.5rem, 10vw, 9rem);
        padding-bottom: 1rem;
    }
    .hero-intro {
        display: grid;
        gap: 3rem;
        align-items: start;
    }
    .hero-name {
        font-size: clamp(3rem, 5vw, 5rem);
        letter-spacing: -0.045em;
    }
    .hero-tools {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 1rem;
    }
    .hero-tools:empty {
        display: none;
    }
    @media (min-width: 768px) {
        .hero-intro {
            grid-template-columns: 1fr 1.15fr;
            gap: clamp(3rem, 6vw, 7rem);
        }
    }
    @media (min-width: 1024px) {
        .hero-intro {
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 0 3rem;
        }
        .hero-identity {
            display: contents;
        }
        .hero-identity > p:first-child,
        .hero-name {
            grid-column: 1 / -1;
        }
        .hero-name {
            font-size: clamp(5.5rem, 10vw, 9rem);
            font-stretch: 115%;
        }
        .hero-name br {
            display: none;
        }
        .hero-summary {
            grid-column: 1;
            max-width: 38rem;
        }
        .hero-actions {
            grid-column: 2;
            grid-row: 3;
            align-self: end;
            margin-top: 1.5rem;
        }
    }
    @media (max-width: 767px) {
        .hero {
            padding-top: 5.5rem;
        }
        .hero-name {
            font-size: 2.5rem;
        }
        .action-link {
            padding-inline: 1rem;
            gap: 1rem;
        }
        .hero-intro {
            gap: 1.5rem;
        }
    }
    @media (orientation: landscape) and (max-height: 30rem) {
        .hero {
            padding-top: 6rem;
        }
        .hero-name {
            font-size: 4rem;
        }
    }
</style>
