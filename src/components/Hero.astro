---
import { site } from '../lib/data';
import RetentionStudy from './RetentionStudy.astro';
---

<section id="top" data-hero data-minimap="Intro" class="section-x hero">
    <div class="hero-intro">
        <div>
            <p class="mb-5 text-sm text-muted">{site.role}</p>
            <h1 class="heading hero-name">
                Thomas
                <br />
                Breindl
            </h1>
            <p class="mt-6 max-w-sm text-base leading-relaxed text-muted">
                Backend systems and the interfaces around them. Studying computer science in {site.location}.
            </p>
            <div class="mt-7 flex flex-wrap items-center gap-6">
                <a href="#work" class="action-link">
                    Explore my work <span aria-hidden="true">↘</span>
                </a>
                <a href="#contact" class="link-line touch-target text-sm text-muted transition-colors hover:text-fg">
                    Get in touch
                </a>
            </div>
        </div>
        <RetentionStudy />
    </div>
    <div data-hero-tools class="hero-tools">
        <p class="text-xs text-muted">Java, Go, Kotlin & TypeScript</p>
    </div>
</section>

<style>
    .hero {
        padding-top: clamp(7.5rem, 10vw, 9rem);
        padding-bottom: 1rem;
    }
    .hero-intro {
        display: grid;
        gap: 3rem;
        align-items: start;
    }
    .hero-name {
        font-size: clamp(3rem, 5vw, 5rem);
        letter-spacing: -0.045em;
    }
    .hero-tools {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 1.25rem;
    }
    @media (min-width: 1024px) {
        .hero-intro {
            grid-template-columns: 1fr 1.15fr;
            gap: clamp(3rem, 6vw, 7rem);
        }
    }
    @media (orientation: landscape) and (max-height: 30rem) {
        .hero {
            padding-top: 6rem;
        }
        .hero-name {
            font-size: 4rem;
        }
    }
</style>
