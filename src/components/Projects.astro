---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import HealthFlow from './HealthFlow.astro';
import RestorePreview from './RestorePreview.astro';
import { isExternalHref } from '../lib/links';

interface Props {
    work: CollectionEntry<'work'>[];
}

const { work } = Astro.props;
---

<section id="work" data-projects data-minimap="Work" class="section-x section-y section-y--lead">
    <SectionHeading index="01" title="Selected work" />
    <div class="grid gap-x-8 gap-y-14 md:grid-cols-2 md:gap-y-16">
        {work.map((entry) => {
            const p = entry.data;
            const titleId = `project-${entry.id}`;
            return (
                <article data-card-wrapper data-card class="project-entry min-w-0">
                    <a href={`/work/${entry.id}`} aria-labelledby={titleId} class="project-link group block rounded-lg">
                        <div class="project-image overflow-hidden rounded-lg border border-line bg-bg-raise">
                            {entry.id === 'aqt-sync' ? (
                                <RestorePreview />
                            ) : entry.id === 'aqt-health' ? (
                                <HealthFlow />
                            ) : p.image ? (
                                <Picture
                                    src={p.image}
                                    alt={p.imageAlt ?? `${p.title} website preview`}
                                    formats={['avif', 'webp']}
                                    widths={[480, 720, 960, 1280]}
                                    sizes="(min-width: 1616px) 752px, (min-width: 768px) calc((100vw - 7rem) / 2), calc(100vw - 2.5rem)"
                                    loading="lazy"
                                    class="h-full w-full object-cover transition-transform duration-500 ease-out-strong motion-safe:group-hover:scale-[1.025] motion-safe:group-focus-visible:scale-[1.025]"
                                />
                            ) : (
                                <div class="grid h-full place-items-center p-8 text-center text-2xl text-muted">
                                    {p.subtitle}
                                </div>
                            )}
                        </div>
                        <div class="mt-5 flex items-baseline justify-between gap-4">
                            <h3
                                id={titleId}
                                class="heading text-2xl leading-tight transition-colors group-hover:text-accent group-focus-visible:text-accent md:text-3xl"
                            >
                                <span class="sr-only">Case study: </span>
                                {p.title}
                            </h3>
                            <span
                                aria-hidden="true"
                                class="text-xl text-muted transition-[color,transform] group-hover:translate-x-1 group-hover:text-accent group-focus-visible:text-accent"
                            >
                                →
                            </span>
                        </div>
                        <p class="mt-2 max-w-xl text-sm leading-relaxed text-muted md:text-base">{p.summary}</p>
                    </a>
                    <footer class="mt-4 grid gap-x-4 gap-y-3 border-t border-line pt-4 lg:flex lg:flex-wrap lg:items-center lg:justify-between">
                        <p class="text-xs text-muted">
                            {p.tags.slice(0, 3).join(' / ')} <span aria-hidden="true">·</span> {p.year}
                        </p>
                        <div class="flex flex-wrap gap-x-5 gap-y-7">
                            {p.links.map((link) => {
                                const external = link.external || isExternalHref(link.href);
                                return (
                                    <a
                                        href={link.href}
                                        target={external ? '_blank' : undefined}
                                        rel={external ? 'noopener noreferrer' : undefined}
                                        class="link-line touch-target inline-flex min-h-11 items-center gap-1 text-xs text-fg/80 transition-colors hover:text-accent"
                                    >
                                        {link.label}
                                        <span class="sr-only"> for {p.title}</span>{' '}
                                        <span aria-hidden="true">{external ? '↗' : '→'}</span>
                                        {external && <span class="sr-only">(opens in new tab)</span>}
                                    </a>
                                );
                            })}
                        </div>
                    </footer>
                </article>
            );
        })}
    </div>
</section>

<style>
    [data-projects] {
        --section-lead: 2rem;
    }

    .project-entry {
        scroll-margin-top: 6rem;
    }

    footer .link-line::after {
        bottom: 0.75rem;
    }

    .project-image {
        width: 100%;
        aspect-ratio: 8 / 5;
        min-height: 20rem;
    }
</style>
